# PostgreSQL 接続文字列（docker-compose.yml の設定に合わせる）
# 例: postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
DATABASE_URL=

# 国土交通省「不動産情報ライブラリ」API キー（地価公示 XPT002 / 実取引 XIT001 共通）
# 取得: https://www.reinfolib.mlit.go.jp/  （API 利用登録が必要）
REINFOLIB_API_KEY=

# e-Stat アプリケーション ID（平均家賃 / 住宅・土地統計調査）
# 取得: https://www.e-stat.go.jp/api/  （無料のユーザー登録が必要。Reinfolib とは別物）
ESTAT_APP_ID=

# 任意: 上書きする場合のみ設定
# LAND_PRICE_YEAR=2026
# TRANSACTION_PRICE_YEAR=2025
# LAND_PRICE_TILE_ZOOM=13
