# docker-compose.yml（PostgreSQL）用の環境変数。
# このファイルをコピーして .env を作成し、パスワードを設定する。
#   copy .env.example .env
#
# ここで決めた USER / PASSWORD / DB / PORT に合わせて
# backend/.env の DATABASE_URL を設定すること:
#   DATABASE_URL=postgresql+psycopg://<USER>:<PASSWORD>@localhost:<PORT>/<DB>

POSTGRES_USER=japan_map_user
POSTGRES_PASSWORD=
POSTGRES_DB=japan_map
POSTGRES_PORT=5432
